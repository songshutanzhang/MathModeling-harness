{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "selected_blind_label",
    "reliability_gate",
    "reliability_score",
    "competition_upside_score",
    "baseline_comparison",
    "failure_conditions",
    "selection_reason",
    "prototype_ids"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "selected_blind_label": {"type": "string", "pattern": "^ROUTE-[A-F0-9]{10}$"},
    "reliability_gate": {"enum": ["PASS", "FAIL"]},
    "reliability_score": {"type": "number", "minimum": 0, "maximum": 100},
    "competition_upside_score": {"type": "number", "minimum": 0, "maximum": 100},
    "baseline_comparison": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 3}},
    "failure_conditions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 3}},
    "selection_reason": {"type": "string", "minLength": 10},
    "prototype_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 2}}
  }
}
