{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "sequence",
    "event_id",
    "finding_id",
    "action",
    "reviewer_role",
    "reviewer_id",
    "failure_review_sha256",
    "solver_response_sha256",
    "independent_validation_sha256",
    "evidence",
    "verification_scope",
    "recorded_at",
    "previous_event_hash",
    "event_hash"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "sequence": {"type": "integer", "minimum": 1},
    "event_id": {"type": "string", "minLength": 3},
    "finding_id": {"type": "string", "minLength": 2},
    "action": {"enum": ["closed", "reopened"]},
    "reviewer_role": {"enum": ["independent_validator", "failure_hunter"]},
    "reviewer_id": {"type": "string", "minLength": 3},
    "failure_review_sha256": {"type": "string", "pattern": "^[0-9A-F]{64}$"},
    "solver_response_sha256": {"type": "string", "pattern": "^[0-9A-F]{64}$"},
    "independent_validation_sha256": {"type": "string", "pattern": "^[0-9A-F]{64}$"},
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[0-9A-F]{64}$"}
        }
      }
    },
    "verification_scope": {"type": "string", "minLength": 8},
    "recorded_at": {"type": "string", "format": "date-time"},
    "previous_event_hash": {"type": "string", "pattern": "^[0-9A-F]{64}$"},
    "event_hash": {"type": "string", "pattern": "^[0-9A-F]{64}$"}
  }
}
