{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/mathmodel/harness_run_metrics.schema.json",
  "title": "Math-modeling harness run metrics",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "run_id", "harness_ref", "benchmark_id",
    "cases_evaluated", "hard_failures", "hard_failure_rate",
    "reliability_score", "competition_upside_score", "token_usage",
    "wall_clock_seconds", "tool_calls", "route_diversity",
    "model_family_diversity", "blind_paper_score"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "run_id": {"type": "string", "minLength": 1},
    "harness_ref": {"type": "string", "minLength": 1},
    "benchmark_id": {"type": "string", "minLength": 1},
    "cases_evaluated": {"type": "integer", "minimum": 1},
    "hard_failures": {"type": "integer", "minimum": 0},
    "hard_failure_rate": {"type": "number", "minimum": 0, "maximum": 1},
    "reliability_score": {"type": "number", "minimum": 0, "maximum": 100},
    "competition_upside_score": {"type": "number", "minimum": 0, "maximum": 100},
    "token_usage": {"type": "integer", "minimum": 0},
    "wall_clock_seconds": {"type": "number", "minimum": 0},
    "tool_calls": {"type": "integer", "minimum": 0},
    "route_diversity": {"type": "number", "minimum": 0, "maximum": 1},
    "model_family_diversity": {"type": "number", "minimum": 0, "maximum": 1},
    "blind_paper_score": {"type": "number", "minimum": 0, "maximum": 100},
    "artifact_tier": {"enum": ["tier1", "tier2", "tier3"]},
    "contamination_status": {"enum": ["clean", "suspected", "failed"]},
    "notes": {"type": "array", "items": {"type": "string"}}
  }
}
