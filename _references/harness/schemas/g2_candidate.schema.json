{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "candidate_id", "isolation", "problem_freeze_sha256", "model_family", "core_idea", "problem_structure_used", "assumptions", "variables", "mathematical_form", "required_data", "baseline", "expected_advantage", "failure_modes", "validation_plan", "computational_cost", "novelty_source", "risk_level"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "candidate_id": {"type": "string", "pattern": "^CAND-[A-Z0-9_-]+$"},
    "isolation": {
      "type": "object", "additionalProperties": false,
      "required": ["visibility", "other_candidate_ids_seen", "solver_advocacy_seen"],
      "properties": {
        "visibility": {"const": "problem_freeze_only"},
        "other_candidate_ids_seen": {"type": "array", "maxItems": 0},
        "solver_advocacy_seen": {"const": false}
      }
    },
    "problem_freeze_sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"},
    "model_family": {"type": "string", "minLength": 2},
    "core_idea": {"type": "string", "minLength": 10},
    "problem_structure_used": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "assumptions": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "variables": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "mathematical_form": {"type": "string", "minLength": 10},
    "required_data": {"type": "array", "items": {"type": "string"}},
    "baseline": {"type": "string", "minLength": 3},
    "expected_advantage": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "failure_modes": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "validation_plan": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "computational_cost": {"enum": ["low", "medium", "high", "very_high"]},
    "novelty_source": {"type": "string", "minLength": 3},
    "risk_level": {"enum": ["low", "medium", "high"]}
  }
}
