{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "problem_id", "skill_version", "model_version", "mode", "artifact_tier", "source_exposure", "result", "paper", "figures", "g2_route", "g5_decision", "ai_usage", "timestamp"],
  "properties": {
    "schema_version": {"enum": ["1.0", "1.1"]},
    "run_id": {"type": "string", "minLength": 1},
    "problem_id": {"type": "string", "minLength": 1},
    "skill_version": {"type": "string", "minLength": 1},
    "model_version": {"type": "string", "minLength": 1},
    "mode": {"const": "training_run"},
    "artifact_tier": {"const": "tier1"},
    "source_exposure": {"type": "string", "minLength": 1},
    "result": {"$ref": "#/$defs/artifact"},
    "paper": {"$ref": "#/$defs/artifact"},
    "figures": {"$ref": "#/$defs/artifact"},
    "harness_profile": {"$ref": "#/$defs/artifact"},
    "g2_route": {"type": "string", "minLength": 1},
    "g5_decision": {"type": "string", "minLength": 1},
    "ai_usage": {
      "type": "object", "additionalProperties": false,
      "required": ["model", "major_roles", "external_sources_used"],
      "properties": {
        "model": {"type": "string", "minLength": 1},
        "major_roles": {"type": "array", "items": {"type": "string"}},
        "external_sources_used": {"type": "array", "items": {"type": "string"}}
      }
    },
    "timestamp": {"type": "string", "format": "date-time"}
  },
  "allOf": [
    {
      "if": {"properties": {"schema_version": {"const": "1.1"}}},
      "then": {"required": ["harness_profile"]}
    }
  ],
  "$defs": {
    "artifact": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"}
      }
    }
  }
}
